# Site (SEO + 301 redirects — apex HTTPS only, no www)
# Production Heroku env: NEXT_PUBLIC_SITE_URL=https://calorieapi.com
# Middleware 301s http→https and www→apex when this is set to the live domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Calorie API
NEXT_PUBLIC_SITE_TITLE=Food Calorie API for Developers | Calorie API
NEXT_PUBLIC_SITE_DESCRIPTION=Food calorie API for developers: REST search, barcode lookup, macros per 100g, and autocomplete across our food database API. Free tier for nutrition apps.
NEXT_PUBLIC_SITE_KEYWORDS=food calorie api,food API,nutrition API,food database API,calorie API,nutrition database API,food search API,barcode nutrition API
NEXT_PUBLIC_SUPPORT_EMAIL=support@calorieapi.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R0Y4S4NLKN
NEXT_PUBLIC_HERO_IMAGE_VERSION=2

# Link preview image (Open Graph / Twitter) — one image for all shared URLs
# Default: /images/bg-banner.png — override with any public HTTPS URL or site path
# NEXT_PUBLIC_OG_IMAGE_URL=https://calorieapi.com/images/bg-banner.png
# NEXT_PUBLIC_OG_IMAGE_VERSION=1
# NEXT_PUBLIC_OG_IMAGE_ALT=Calorie API — nutrition data for developers

# Food catalog size shown in marketing UI (default: 4M+ foods)
# NEXT_PUBLIC_FOOD_DATABASE_SIZE=4M+ foods

# Backend API (local dev: http://localhost:8000)
# Production Heroku example:
# NEXT_PUBLIC_API_URL=https://food-nutrition-database-cd7099c2be07.herokuapp.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Entity signals for Organization JSON-LD (SEO / AI search)
# Comma-separated profile URLs: GitHub org, X/Twitter, LinkedIn, Crunchbase, API directories
# NEXT_PUBLIC_ORG_SAMEAS=https://github.com/your-org,https://x.com/your-handle
# NEXT_PUBLIC_LEGAL_NAME=BusyBody FIT LTD
# NEXT_PUBLIC_ORG_FOUNDING_DATE=2024-01-01

# Trust stats on the home page — only rendered when set (never publish unmeasured numbers)
# NEXT_PUBLIC_STAT_UPTIME=99.9%
# NEXT_PUBLIC_STAT_LATENCY=120ms
